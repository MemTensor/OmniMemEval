# ============================================================
# OmniMemEval - ThreadAtlas (in-process, one local store per user)
# Usage: ./scripts/run_lme_eval.sh --lib threadatlas --env .env.threadatlas
#        ./scripts/run_locomo_eval.sh --lib threadatlas --env .env.threadatlas
# ============================================================

# --- ThreadAtlas ---------------------------------------------
THREADATLAS_REPO="<PATH_TO_THREADATLAS_CHECKOUT>"     # REQUIRED - imported, never modified
THREADATLAS_STATE_DIR="<PATH_TO_USER_STORES>"         # REQUIRED - one folder per user_id
THREADATLAS_STORE_DIR="<PATH_TO_STORE>"               # threadatlas.sqlite and threadatlas.npy (global layer 0.7)
THREADATLAS_STEP0_DIR="<PATH_TO_STEP0_EXPORT>"        # documents.jsonl and units.jsonl
THREADATLAS_SOURCE="<PATH_TO_longmemeval_s.json>"     # the file the store's chats were read from
OPENAI_API_KEY="<YOUR_API_KEY>"                       # reads sessions the store has not read
# THREADATLAS_READ_MODEL="gpt-5.6-luna"               # the reading model; gpt-4.1-mini-2025-04-14 also works
# THREADATLAS_HOPS=2                                  # reported runs: 2 hops from 40 hits of each search
# THREADATLAS_HITS=40

# Runner defaults
LLM_WORKERS=10

# Search parameters
TOPK=20

# --- ANSWER (Answer Generation) ------------------------------
ANSWER_MODEL="gpt-4.1-mini-2025-04-14"
ANSWER_BASE_URL="https://api.openai.com/v1"
ANSWER_API_KEY="<YOUR_ANSWER_API_KEY>"

# --- EVAL (LLM-as-Judge Scoring) -----------------------------
EVAL_MODEL="gpt-4o-mini-2024-07-18"
EVAL_BASE_URL="https://api.openai.com/v1"
EVAL_API_KEY="<YOUR_EVAL_API_KEY>"
