# ============================================================
# OmniMemEval - CPersona (self-hosted, MCP over streamable HTTP)
# Usage: ./scripts/run_lme_eval.sh --lib cpersona --env .env.cpersona
#        ./scripts/run_locomo_eval.sh --lib cpersona --env .env.cpersona
#
# The CPersona server runs separately; see docs/user_memory/cpersona.md for its
# version and settings, and for running the stages one at a time (the submitted
# runs waited for the server's build queue between ingestion and search). CPersona calls no model to store or search, so no
# memory-service model is configured here.
# ============================================================

# --- CPersona ------------------------------------------------
CPERSONA_MCP_URL="http://127.0.0.1:<PORT>/mcp"       # REQUIRED - the server's MCP endpoint
CPERSONA_AUTH_TOKEN="<THE_SERVER_BEARER_TOKEN>"      # REQUIRED - the server's CPERSONA_AUTH_TOKEN
CPERSONA_SEARCH_MODE="pro"                           # reconstruct's mode: pro or lite (the submitted rows: pro)
# CPERSONA_SEARCH_COUNT=                             # unset: the mode's default count
# CPERSONA_TIMEOUT_SECONDS=600

# Runner defaults
LLM_WORKERS=10

# Search parameters (TOPK is not passed to CPersona; the mode decides how much is returned)
TOPK=20

# --- ANSWER (Answer Generation) ------------------------------
ANSWER_MODEL="gpt-4.1-mini-2025-04-14"
ANSWER_BASE_URL="https://api.openai.com/v1"
ANSWER_API_KEY="<YOUR_ANSWER_API_KEY>"

# --- EVAL (LLM-as-Judge Scoring) -----------------------------
EVAL_MODEL="gpt-4o-mini-2024-07-18"
EVAL_BASE_URL="https://api.openai.com/v1"
EVAL_API_KEY="<YOUR_EVAL_API_KEY>"
