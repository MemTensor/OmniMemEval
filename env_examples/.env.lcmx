# ============================================================
# OmniMemEval — LCM-X (hermes-lcm, in-process, local store)
# Usage: ./scripts/run_locomo_eval.sh --lib lcmx --env .env.lcmx
# ============================================================

# ─── LCM-X ───────────────────────────────────────────────────
LCMX_REPO="<PATH_TO_LCM_X_CHECKOUT>"               # ⚠️ REQUIRED — imported, never modified
LCMX_DB_ROOT="<PATH_TO_LCMX_STORES>"               # ⚠️ REQUIRED — one store per user_id
LCMX_CONFIG="fleet"                                # fleet: fastembed embeddings on | off: full-text only
LCMX_CHUNK_POLICY="full"                           # reported runs: embed every message, including short turns
LCMX_DELIVERY="full"                               # reported runs: return full stored messages per hit
LCMX_EMBED_PROVIDER="fastembed"                     # reported runs: local ONNX embeddings
LCMX_EMBED_MODEL="BAAI/bge-small-en-v1.5"             # reported runs: 384-dimensional English embedding model
HF_HUB_OFFLINE=1                                   # use the already-downloaded FastEmbed model
# LCMX_EMBED_CACHE="<PATH_TO_EMBED_CACHE_SQLITE>"  # optional text->vector cache (LCM-X LongMemEval harness format)
# FASTEMBED_CACHE_PATH="~/.cache/fastembed"

# Runner defaults
LLM_WORKERS=10

# Search parameters
TOPK=20

# ─── ANSWER (Answer Generation) ─────────────────────────────
ANSWER_MODEL="gpt-4.1-mini-2025-04-14"
ANSWER_BASE_URL="https://api.openai.com/v1"        # ⚠️ REQUIRED — set your LLM endpoint
ANSWER_API_KEY="<YOUR_ANSWER_API_KEY>"             # ⚠️ REQUIRED

# ─── EVAL (LLM-as-Judge Scoring) ────────────────────────────
EVAL_MODEL="gpt-4o-mini-2024-07-18"
EVAL_BASE_URL="https://api.openai.com/v1"          # ⚠️ REQUIRED — set your LLM endpoint
EVAL_API_KEY="<YOUR_EVAL_API_KEY>"                 # ⚠️ REQUIRED

# ─── Optional Shared Controls ───────────────────────────────
# Global LLM retry/timeout controls. ANSWER_* and EVAL_* override LLM_*.
# LLM_MAX_RETRIES=4
# LLM_TIMEOUT_SECONDS=600

# Long add-call progress logging. Set to 0 to disable periodic heartbeat logs.
# OMNIMEMEVAL_ADD_HEARTBEAT_SECONDS=30
